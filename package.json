{
  "name": "vue36-enterprise-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:bundled": "VITE_BUNDLED_DEV=true vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint . --fix --deny-warnings",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "pinia": "^3.0.0",
    "ant-design-vue": "^4.2.0",
    "@ant-design/icons-vue": "^7.0.0",
    "axios": "^1.7.0",
    "@vueuse/core": "^12.0.0",
    "dayjs": "^1.11.0",
    "nprogress": "^0.2.0",
    "js-cookie": "^3.0.5",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "vite": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "less": "^4.2.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.3.0",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "@types/node": "^22.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/crypto-js": "^4.2.2",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vitest/ui": "^3.0.0",
    "jsdom": "^25.0.0",
    "web-vitals": "^4.2.0"
